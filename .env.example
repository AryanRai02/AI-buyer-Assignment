# ==============================================================================
# AI Purchasing Agent - Environment Configuration
# ==============================================================================

# LLM Provider: 'gemini', 'auto', or 'deterministic'
# If no API key is provided, the agent runs in deterministic autonomous mode with full reasoning traces!
LLM_PROVIDER=auto

# Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY="paste API key here"

# Model override (optional)
GEMINI_MODEL=gemini-2.5-flash

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
